# Entorno de la aplicación (development / production)
APP_ENV=development

# Configuración del servidor Backend Go
PORT=8080

# Configuración de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sinapsa_db
DB_SSLMODE=disable

# Seguridad JWT (cámbialo en producción — mínimo 32 chars)
JWT_SECRET=dev-super-secret-change-in-production-32chars!

# OTP — expiración en minutos
OTP_EXPIRY_MINUTES=10

# Resend — 100% funcional para OTP
# 1) Crea cuenta en https://resend.com  2) Verifica tu dominio o usa onboarding@resend.dev para pruebas
# 3) Genera API Key en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Sinapsa <onboarding@resend.dev>
# En producción usa tu dominio verificado, ej: Sinapsa <noreply@sinapsa.health>

# Frontend URL para CORS
FRONTEND_URL=http://localhost:5173

# Configuración del Frontend React
VITE_BACKEND_URL=http://localhost:8080
